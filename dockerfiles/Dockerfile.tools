#             https://download-cdn.jetbrains.com/kotlin-lsp/${KOTLIN_LSP_VERSION}/kotlin-${KOTLIN_LSP_VERSION}.vsix; \
#     fi && \
#     cp /var/cache/kotlin/kotlin-${KOTLIN_LSP_VERSION}.vsix ${CODE_EXTENSIONS_DIR}/kotlin.vsix
