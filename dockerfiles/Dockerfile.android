# Android SDK & NDK stage
FROM java-image
ARG ANDROID_CMDLINE_TOOLS_VERSION=13114758
ARG ANDROID_NDK_VERSION=27.2.12479018
ARG ANDROID_API_LEVEL=34
ARG ANDROID_BUILD_TOOLS_VERSION=34.0.0

ENV PATH=/opt/android-sdk/cmdline-tools/latest/bin:/opt/android-sdk/platform-tools:/opt/android-sdk/build-tools/${ANDROID_BUILD_TOOLS_VERSION}:$PATH

RUN apt-get update && apt-get install -y unzip && rm -rf /var/lib/apt/lists/*

# Use cache mount for Android command line tools
RUN --mount=type=cache,target=/var/cache/android \
    mkdir -p /opt/android-sdk/cmdline-tools && \
    if [ ! -f /var/cache/android/commandlinetools-linux-${ANDROID_CMDLINE_TOOLS_VERSION}_latest.zip ]; then \
        curl -fsSL -o /var/cache/android/commandlinetools-linux-${ANDROID_CMDLINE_TOOLS_VERSION}_latest.zip \
            https://dl.google.com/android/repository/commandlinetools-linux-${ANDROID_CMDLINE_TOOLS_VERSION}_latest.zip; \
    fi && \
    unzip /var/cache/android/commandlinetools-linux-${ANDROID_CMDLINE_TOOLS_VERSION}_latest.zip -d /opt/android-sdk/cmdline-tools && \
    mv /opt/android-sdk/cmdline-tools/cmdline-tools /opt/android-sdk/cmdline-tools/latest

# Use cache mount for SDK components with proper cache directory
RUN --mount=type=cache,target=/var/cache/android-sdk \
    --mount=type=cache,target=/root/.android \
    export ANDROID_HOME=/opt/android-sdk && \
    # Set Android SDK cache directory to our cache mount
    export ANDROID_SDK_ROOT=/opt/android-sdk && \
    export ANDROID_USER_HOME=/root/.android && \
    echo "Accepting Android SDK licenses..." && \
    yes | sdkmanager --sdk_root=/opt/android-sdk --licenses > /dev/null 2>&1 && \
    echo "Installing Android SDK components..." && \
    # The SDK manager will cache downloaded packages in its own cache
    sdkmanager --sdk_root=/opt/android-sdk --verbose \
        "platform-tools" \
        "platforms;android-${ANDROID_API_LEVEL}" \
        "build-tools;${ANDROID_BUILD_TOOLS_VERSION}" \
        "ndk;${ANDROID_NDK_VERSION}" \
        "cmake;3.22.1" \
        "emulator" \
        "system-images;android-${ANDROID_API_LEVEL};google_apis;x86_64" && \
    echo "Creating AVD..." && \
    avdmanager create avd --name default --device "Galaxy Nexus" \
        --package "system-images;android-${ANDROID_API_LEVEL};google_apis;x86_64" --force && \
    echo "Android SDK installation complete - cache preserved in mount"
